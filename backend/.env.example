# MongoDB Atlas connection string (free M0 cluster)
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/meetslot

# Server
PORT=5000
NODE_ENV=production

# Frontend URL (Vercel deployment) - used for CORS
CLIENT_URL=https://your-frontend.vercel.app

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# --- Email notifications ---
# A single Gmail account used ONLY to SEND emails (booking notifications to
# advisors, confirmations to students). This is NOT any advisor's personal
# inbox - create one dedicated Gmail account for this (e.g. cdc.meetslot@gmail.com),
# turn on 2-Step Verification on it, then generate an "App Password":
# myaccount.google.com -> Security -> 2-Step Verification -> App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your_16_character_app_password

# --- Initial account seeding ---
# Visit https://<your-backend>/api/setup/seed?secret=<SEED_SECRET> once in your
# browser after deploying to create the master admin + 10 advisor accounts
# (Render's free tier has no Shell access, so this replaces `npm run seed`).
# Make up any random string here - it's just a password-like gate on that URL.
SEED_SECRET=pick_any_random_string_here
MASTER_ADMIN_USERNAME=masteradmin
MASTER_ADMIN_PASSWORD=ChangeThisPassword123!
# Advisor seed accounts are named advisor1..advisor10 with this shared
# starting password; each one is forced to change it on first login.
ADVISOR_SEED_PASSWORD=ChangeThisPassword123!
